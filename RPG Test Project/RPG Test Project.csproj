<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RPG_Test_Project</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateTestGlobalUsings>false</GenerateTestGlobalUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="DotNetSeleniumExtras.WaitHelpers" Version="3.11.0" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.39.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="Xunit.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <!-- Force xUnit v2 only -->
	  <PackageReference Include="xunit.core" Version="2.6.6" />
	  <PackageReference Include="xunit.assert" Version="2.6.6" />
	  <PackageReference Include="xunit.abstractions" Version="2.0.3" />

	  <!-- Prevent xunit.v3 from being referenced -->
	  <PackageReference Update="xunit.v3.common" Version="0.0.0" PrivateAssets="All" />
	  <PackageReference Update="xunit.v3.extensibility.core" Version="0.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
